                                  {
                                    "key": "content",
                                    "value": {
                                      "stringValue": "Okay, I guess I didn't realize there was so much process around this - I'll have Finance call Calder to verify first. Can you go ahead and put the invoice on hold in the meantime? I'll get you the invoice ID in a few minutes."
                                    }
